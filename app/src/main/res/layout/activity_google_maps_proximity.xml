<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Map and Top Controls Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Google Maps SupportMapFragment -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/map_fragment"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Top Floating Selection Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/white"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_select_barangay_nasugbu"
                    android:textColor="@color/brand_blue"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Dropdown / Spinner for selecting Barangay -->
                <Spinner
                    android:id="@+id/spinner_barangay"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:spinnerMode="dropdown" />

                <!-- Proximity Filter Status Badge -->
                <TextView
                    android:id="@+id/tv_filter_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#E8F4FD"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="@string/filter_status_1_5km"
                    android:textColor="@color/brand_blue"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    <!-- Material Design BottomSheet Details Panel (Hidden by default) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/bottom_sheet_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:behavior_hideable="true"
        app:behavior_peekHeight="0dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Bottom Sheet Drag Handle -->
            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp"
                android:background="#D1D5DB" />

            <!-- Brand Badge -->
            <TextView
                android:id="@+id/tv_branch_brand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/brand_blue"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="@string/brand_seven_eleven"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Branch Name -->
            <TextView
                android:id="@+id/tv_branch_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/default_branch_name"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:breakStrategy="simple" />

            <!-- Address (Feature 6: Branch Name and Address) -->
            <TextView
                android:id="@+id/tv_branch_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/default_branch_address"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:breakStrategy="simple" />

            <!-- Distance info -->
            <TextView
                android:id="@+id/tv_branch_distance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/default_branch_distance"
                android:textColor="@color/brand_seven_eleven"
                android:textSize="14sp"
                android:textStyle="bold"
                android:breakStrategy="simple" />

            <!-- Coordinates -->
            <TextView
                android:id="@+id/tv_branch_coordinates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/default_branch_coordinates"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:breakStrategy="simple" />

            <!-- Close Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_close_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginTop="16dp"
                android:text="@string/btn_close_details"
                android:textAllCaps="false"
                app:cornerRadius="12dp"
                app:backgroundTint="@color/brand_blue" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
